# ─── Required ───
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

# ─── Optional ───
DATABASE_URL=data/database/dubizzle.db
EXPORTS_DIR=
APP_ENV=development
LOG_LEVEL=INFO
ADMIN_API_KEY=

# ─── Booking defaults ───
BOOKING_MIN_LEAD_TIME_HOURS=2
BOOKING_VIEWING_DURATION_MINUTES=60

# ─── Agent & frontend defaults ───
USD_TO_AED_RATE=3.6725
AGENT_MAX_TOOL_CALLS=5
GEMINI_REQUEST_TIMEOUT_MS=20000
AGENT_TURN_TIMEOUT_SECONDS=45.0
DUBIZZLE_API_URL=http://127.0.0.1:8000
DUBIZZLE_API_TIMEOUT=12.0
DUBIZZLE_CHAT_TIMEOUT=60.0
